# ==============================================================================
# Vahak - Comprehensive Git Ignore
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/coverage/
**/linux/flutter/ephemeral/
**/android/local.properties
**/android/.gradle/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/gradle-wrapper.jar
**/*.keystore
**/*.jks

# ── Rust ──────────────────────────────────────────────────────────────────────
**/target/
**/*.rs.bk
test_scripts/rust_server/target/

# ── Compiled Binaries & Test Artifacts ─────────────────────────────────────────
*.exe
*.out
*.app
test_scripts/*_cpp
test_scripts/*_go
test_scripts/*.mp4

# ── IDEs & Operating Systems ──────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Secrets & Environment Variables ───────────────────────────────────────────
.env
.env.*
!.env.example
